{
  "name": "grok-usage-gauge",
  "version": "1.0.0",
  "private": true,
  "description": "Local four-tank Grok / Cursor usage gauge. Paste spending dashboard figures; nothing is sent to a server.",
  "type": "module",
  "scripts": {
    "postinstall": "node scripts/prepare-ocr.mjs",
    "prepare-ocr": "node scripts/prepare-ocr.mjs",
    "dev": "node scripts/prepare-ocr.mjs && vite --host --port 5173 --strictPort",
    "build": "node scripts/prepare-ocr.mjs && tsc --noEmit && vite build",
    "preview": "vite preview --host --port 4173 --strictPort",
    "test": "vitest run"
  },
  "devDependencies": {
    "typescript": "^5.9.2",
    "vite": "^7.1.5",
    "vitest": "^3.2.4"
  },
  "dependencies": {
    "tesseract.js": "^7.0.0"
  }
}
